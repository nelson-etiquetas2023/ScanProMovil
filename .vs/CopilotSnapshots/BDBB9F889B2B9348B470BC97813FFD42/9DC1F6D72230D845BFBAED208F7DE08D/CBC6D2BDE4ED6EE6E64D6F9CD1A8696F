<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ScanProMovil.Views.ShoppingPage"
             Title="ShoppingPage"
             xmlns:models="clr-namespace:ScanProMovil.Models"
             xmlns:vm="clr-namespace:ScanProMovil.ViewModels"
             x:DataType="vm:OrderViewModel">

    <Grid Padding="1"
          RowDefinitions="Auto,Auto,*">
        <!--Barra de Acciones-->
        <ScrollView Grid.Row="0" 
                    Orientation="Horizontal">
            <HorizontalStackLayout 
                Spacing="3">
                <Button Text="ADD"
                 ImageSource="add.png"
                 BackgroundColor="DodgerBlue" 
                 ContentLayout="Top, 2"
                 TextColor="White" WidthRequest="80"/>
                <Button Text="EDIT"
                 ImageSource="edit.png"
                 BackgroundColor="DodgerBlue" 
                 ContentLayout="Top, 2"
                 TextColor="White" WidthRequest="80"/>
                <Button Text="SINC"
                 ImageSource="uploadcloud.png"
                 BackgroundColor="DodgerBlue" 
                 ContentLayout="Top, 2"
                 TextColor="White" WidthRequest="80"/>
                <Button Text="DELETE"
                 ImageSource="delete.png"
                 BackgroundColor="DodgerBlue" 
                 ContentLayout="Top, 2"
                 TextColor="White"  WidthRequest="80"/>
                <Button Text="CANCEL"
                 ImageSource="cancel.png"
                 BackgroundColor="DodgerBlue" 
                 ContentLayout="Top, 2"
                 TextColor="White" WidthRequest="80"/>
            </HorizontalStackLayout>
        </ScrollView>
        <!--Barra de Busqueda -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width=".7*"></ColumnDefinition>
                <ColumnDefinition Width=".3*"></ColumnDefinition>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0"
            Margin="0,5,0,0"
            Stroke="gray"
            StrokeThickness="1"
            Background="White">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="10"></RoundRectangle>
                </Border.StrokeShape>
                <SearchBar 
            Placeholder="Buscar Ordenes..." FontAttributes="Bold"/>
            </Border>
            <Label Text="{Binding Ordenes.Count, StringFormat='{0} Items.'}" 
           Grid.Column="1" 
           FontSize="10" 
           FontAttributes="Bold" VerticalTextAlignment="Center" 
          HorizontalOptions="Center" Background="Gray" 
          Margin="0,5,0,5" Padding="20,0,20,0"/>

        </Grid>
        <!--Lista de Ordenes - Optimizado para scroll fluido-->
        <CollectionView Grid.Row="2"
            x:Name="collectionView"
            EmptyView="No Data..."
            ItemsLayout="VerticalList"
            SelectionMode="Multiple"
            ItemsSource="{Binding Ordenes}">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:Order">
                    <!-- Item container simplificado - menos nesting = mejor rendimiento -->
                    <Border Margin="1,2,1,2" 
                            Stroke="Gray"
                            StrokeThickness="1"
                            Padding="8"
                            BackgroundColor="White">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="8"/>
                        </Border.StrokeShape>

                        <!-- Grid principal - 3 columnas para layout eficiente -->
                        <Grid ColumnSpacing="8" 
                              ColumnDefinitions=".15*,.55*,.3*">

                            <!-- Columna 1: Imagen (sin HorizontalStackLayout) -->
                            <Image Grid.Column="0"
                                   Source="downloads.png"
                                   Aspect="AspectFit"
                                   WidthRequest="50"
                                   HeightRequest="50" />

                            <!-- Columna 2: Información principal (sin VerticalStackLayout) -->
                            <Grid Grid.Column="1" 
                                  RowSpacing="2"
                                  RowDefinitions="Auto,Auto,Auto">
                                <Label Grid.Row="0"
                                       Text="{Binding OrderNumber}" 
                                       FontAttributes="Bold" 
                                       FontSize="18"
                                       LineBreakMode="TailTruncation" />
                                <Label Grid.Row="1"
                                       Text="{Binding OrderDate, StringFormat='Fecha: {0:dd-MM-yyyy}'}"
                                       FontSize="12" />
                                <Grid Grid.Row="2" 
                                      ColumnSpacing="4"
                                      ColumnDefinitions="Auto,Auto">
                                    <Label Grid.Column="0"
                                           Text="Status: " 
                                           FontAttributes="Bold" 
                                           FontSize="12"
                                           VerticalOptions="Center" />
                                    <Border Grid.Column="1"
                                            WidthRequest="80"
                                            Padding="4,3,4,3"
                                            BackgroundColor="{Binding BorderColor}">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="6"/>
                                        </Border.StrokeShape>
                                        <Label Text="{Binding StatusTexto}" 
                                               HorizontalOptions="Center"
                                               FontSize="9"
                                               VerticalOptions="Center" />
                                    </Border>
                                </Grid>
                            </Grid>

                            <!-- Columna 3: Resumen (Items y Costo) -->
                            <Grid Grid.Column="2"
                                  RowSpacing="4"
                                  RowDefinitions="Auto,Auto">
                                <Label Grid.Row="0"
                                       Text="{Binding ItemsNumber, Converter={StaticResource FormattedItemsConverter}}"
                                       FontSize="11"
                                       FontAttributes="Bold"
                                       HorizontalTextAlignment="End" />
                                <Grid Grid.Row="1" 
                                      RowSpacing="1">
                                    <Label Text="Total:" 
                                           FontSize="9"
                                           HorizontalTextAlignment="End" />
                                    <Label Text="{Binding TotalCosto, Converter={StaticResource FormattedPriceConverter}}"
                                           FontAttributes="Bold" 
                                           FontSize="11"
                                           HorizontalTextAlignment="End" />
                                </Grid>
                            </Grid>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
        
        <!--Activity Indicator -->
        <Grid
            Grid.RowSpan="3"
            IsVisible="{Binding IsLoading}"
            BackgroundColor="#80000000"
            ZIndex="100"
            >

            <VerticalStackLayout 
                HorizontalOptions="Center" 
                VerticalOptions="Center">
                
                <ActivityIndicator IsRunning="{Binding IsLoading}"
                                   WidthRequest="60" 
                                   HeightRequest="60"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center"
                                   />

                <Label Text="Cargando órdenes..."
                       TextColor="White"/>

            </VerticalStackLayout>
            
            
        </Grid>
        
        
    </Grid>
</ContentPage>