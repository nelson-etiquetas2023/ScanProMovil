<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ScanProMovil.Views.Compras.SincroComprasPage"
             Title="SINCRONIZACION"
             xmlns:models="clr-namespace:ScanProMovil.Models"
             xmlns:vm="clr-namespace:ScanProMovil.ViewModels.Compras"
             x:DataType="vm:SincroComprasViewModels"
             >
    <VerticalStackLayout>
        <Button x:Name="btn_sincro" 
                Text="Enviar" 
                WidthRequest="300" 
                Command="{Binding SendPurchaseOrderCommand}"/>
        
        <Label Text="Datos de la Orden de Compra" 
               Margin="5,15,0,0" 
               FontAttributes="Bold" />
        <BoxView 
            HeightRequest="1" 
            BackgroundColor="LightGray"
            VerticalOptions="End"
            HorizontalOptions="Fill" 
            Margin="0,15,0,15"/>
        <Label 
            Text="{Binding Orden.Numero, 
            StringFormat='Orden de Compra : {0}' }"
            FontAttributes="Bold" />

        <Label Text="{Binding Orden.Fecha, StringFormat='Fecha: {0}'}" />


    </VerticalStackLayout>
</ContentPage>