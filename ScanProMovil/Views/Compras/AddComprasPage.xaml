<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ScanProMovil.Views.Compras.AddComprasPage"
             Title="AGREGAR COMPRA"
             xmlns:models="clr-namespace:ScanProMovil.Models"
             xmlns:vm="clr-namespace:ScanProMovil.ViewModels"
             x:DataType="vm:AddComprasViewModels">

    <ScrollView>
        <VerticalStackLayout>
            <!--Numero de Orden -->
            <HorizontalStackLayout>
                <Label Text="Orden Numero:" FontAttributes="Bold" />
                <Border 
                    Margin="5,5,5,5"
                    Stroke="Grey"
                    StrokeThickness="1"
                    Background="White">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="10"></RoundRectangle>
                    </Border.StrokeShape>
                    
                    <Entry x:Name="txtOrderNumberEntry" 
                        Placeholder="Ingrese el numero de orden" 
                        FontAttributes="Bold"
                        WidthRequest="170"
                        Text="{Binding NewOrder.Numero}"
                        />
                </Border>
            </HorizontalStackLayout>
            <!--Fecha de la Orden -->
            <HorizontalStackLayout VerticalOptions="Start">
                <Label Text="Fecha:" WidthRequest="135" FontAttributes="Bold" Margin="0,7" />
                <Border 
                    Margin="5,5,5,5"
                    Stroke="Grey"
                    StrokeThickness="1"
                    Background="White" WidthRequest="170">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="10"></RoundRectangle>
                    </Border.StrokeShape>
                    <Grid ColumnDefinitions="Auto,*">
                        <Image
                            Source="edit.png"
                            WidthRequest="22"
                            Grid.Column="0"/>
                        <DatePicker x:Name="txtOrderDateEntry" 
                            FontAttributes="Bold" 
                            Date="{Binding NewOrder.Fecha}" 
                            TextColor ="Black" Grid.Column="1"/>
                    </Grid>
                </Border>
            </HorizontalStackLayout>
            <!--Description Orden Compra-->
            <VerticalStackLayout>
                <Label Text="Descripcion de la orden:" FontAttributes="Bold"/>
                <Border 
                    Margin="5,5,5,5"
                    Stroke="Grey"
                    StrokeThickness="1"
                    Background="White" 
                    WidthRequest="302"
                    >
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="10"></RoundRectangle>
                    </Border.StrokeShape>

                    <Entry x:Name="txt_description"
                        Placeholder="Ingrese Descripción..."
                        Text="{Binding NewOrder.Description}"/>
                </Border>
            </VerticalStackLayout>
            <!-- Datos del proveedor -->
            <Label Text="Datos del proveedor" FontAttributes="Bold"/>
            <HorizontalStackLayout>
                <Border 
                    Margin="10,5,5,5"
                    Stroke="Grey"
                    StrokeThickness="1"
                    Background="White" 
                    WidthRequest="245">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="10"></RoundRectangle>
                    </Border.StrokeShape>
                    <Entry x:Name="txt_supplyName"
                        Placeholder="Ingrese Supply Name..."
                        Text="{Binding NewOrder.Supply_Name}" 
                        WidthRequest="240" />
                </Border>
                <Button x:Name="btn_supplySearch" 
                        Text="..."
                        Clicked="SearchSupplyData" WidthRequest="50"/>
            </HorizontalStackLayout>
            <!--Add Product-->
            <Border Margin="5" 
                Padding="10" 
                StrokeShape="RoundRectangle 6" 
                StrokeThickness="1">
                <VerticalStackLayout>
                    <Label Text="Agregar Productos" FontAttributes="Bold" />
                    <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,*,65">
                        <!--ID PRODUCTO-->
                        <Border 
                            Margin="0,5,0,5"
                            Stroke="Grey"
                            StrokeThickness="1"
                            Background="White"  
                            Grid.Row="0" 
                            Grid.Column="0" WidthRequest="110">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="10"></RoundRectangle>
                            </Border.StrokeShape>
                            <Entry x:Name="txtProductIdEntry" 
                                   Placeholder="id producto" 
                                   WidthRequest="110" Completed="txtProductIdEntry_Completed"  />
                        </Border>
                        <!--Cantidad-->
                        <Border 
                            Margin="5,5,5,5"
                            Stroke="Grey"
                            StrokeThickness="1"
                            Background="White" Grid.Row="0" 
                            Grid.Column="1">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="10"></RoundRectangle>
                            </Border.StrokeShape>
                            <Entry x:Name="txtQuantityEntry" 
                                   Placeholder="cantidad" />
                        </Border>
                        <!--Boton de agregar productos-->
                        <Button x:Name="btnAddProduct" Text="Add" Clicked="btn_AddProducts_Clicked" Grid.Row="0" Grid.Column="2" />
                        <!--Descripcion del producto-->
                        <Border 
                            Margin="0,5,0,5"
                            Stroke="Grey"
                            StrokeThickness="1"
                            Background="White" 
                            Grid.Row="1" 
                            Grid.ColumnSpan="3">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="10"></RoundRectangle>
                            </Border.StrokeShape>
                            <Entry 
                                Placeholder="Nombre del producto" 
                                 x:Name="txt_NameProducts" />
                        </Border>
                    </Grid>
                </VerticalStackLayout>
            </Border>
            <!--Encabezado Detalle de la orden-->
            <Grid ColumnSpacing="0" RowSpacing="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"></RowDefinition>
                    <RowDefinition Height="*"></RowDefinition>
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" Padding="15" Background="#EEE">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100"></ColumnDefinition>
                        <ColumnDefinition Width="100"></ColumnDefinition>
                        <ColumnDefinition Width="60"></ColumnDefinition>
                    </Grid.ColumnDefinitions>
                    <Label Text="Prod. Id" FontAttributes="Bold" Grid.Column="0" VerticalOptions="Center" ></Label>
                    <Label Text="Cant." FontAttributes="Bold" Grid.Column="1" VerticalOptions="Center" ></Label>
                    <Label Text="Action" FontAttributes="Bold" Grid.Column="2" VerticalOptions="Center" ></Label>
                </Grid>
                <CollectionView x:Name="ItemsCollection" 
                    Grid.Row="1" 
                    SelectionMode="None" EmptyView="no data..."
                               
                    ItemsSource="{Binding NewOrder.Items}"
                    ItemsLayout="VerticalList" 
                    ItemSizingStrategy="MeasureAllItems" 
                    HeightRequest="280" HorizontalOptions="Fill">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:DetalleCompra">
                            <Grid Padding="15">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100"></ColumnDefinition>
                                    <ColumnDefinition Width="100"></ColumnDefinition>
                                    <ColumnDefinition Width="60"></ColumnDefinition>
                                </Grid.ColumnDefinitions>
                                <Label Text="{Binding Product_id}" Grid.Column="0" HorizontalOptions="End" />
                                <Label Text="{Binding Cantidad}" Grid.Column="1" VerticalOptions="Center" HorizontalOptions="End"/>
                                <Button x:Name="Btn_DeleteRow" 
                                    Text="x" 
                                    Grid.Column="2" 
                                    WidthRequest="36" 
                                    HeightRequest="28" 
                                    HorizontalOptions="End" 
                                    VerticalOptions="Center"
                                    Clicked="btn_RemoveProducts_Clicked"
                                    CommandParameter="{Binding .}"
                                    />
                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </Grid>
            <!--Summary-->
            <BoxView 
      HeightRequest="0.5"
      HorizontalOptions="Fill"
      Color="LightGray"
      Margin="0,10"/>

            <Label Text="TOTALES => " FontAttributes="Bold" Margin="10"/>
            <BoxView 
                HeightRequest="0.5"
                HorizontalOptions="Fill"
                Color="LightGray"
                Margin="0,10"/>

                    <!--<Label Text="Numero de Filas: "/>
                    <Label x:Name="TotalRowsEntry" FontAttributes="Bold"/>
                    <Label Text="Total Cantidad : "/>
                    <Label x:Name="TotalCantEntry" FontAttributes="Bold"/>-->
            <!--Total Cantidad -->
            <HorizontalStackLayout>
                <Border Margin="5" 
                    Padding="10" 
                    StrokeShape="RoundRectangle 6" 
                    StrokeThickness="1" BackgroundColor="LightGray">
                    <VerticalStackLayout>
                        <Label Text="Renglones : "/>
                        <Label Text="133" FontAttributes="Bold"/>

                    </VerticalStackLayout>
                </Border>
                <Border Margin="5" 
                    Padding="10" 
                    StrokeShape="RoundRectangle 6" 
                    StrokeThickness="1" BackgroundColor="LightGray">
                    <VerticalStackLayout>
                        <Label Text="Total Costo : "/>
                        <Label Text="$2085,88" FontAttributes="Bold"/>

                    </VerticalStackLayout>
                </Border>



            </HorizontalStackLayout>
            
           
            <HorizontalStackLayout 
                HorizontalOptions="Center"
                Margin="10">
                <ActivityIndicator 
                    x:Name="SavingIndicator"
                    IsRunning="False"
                    IsVisible="False"
                    Color="Blue"
                    WidthRequest="50"
                    HeightRequest="50">
                </ActivityIndicator>
                <Label 
                    x:Name="SavingLabel"
                    Text="Guardando..."
                    IsVisible="false"
                    VerticalOptions="Center"
                    TextColor="blue"/>
            </HorizontalStackLayout>
            <BoxView 
    HeightRequest="0.5"
    HorizontalOptions="Fill"
    Color="LightGray"
    Margin="0,10"/>
            <HorizontalStackLayout>
                <Button 
                    x:Name="Btn_Save_Order"
                    Text="Guardar"  
                    Margin="20"
                    Clicked="Btn_Save_Order_Clicked" FontSize="18" />
                <Button Text="Cancelar" Margin="20" FontSize="18" />
            </HorizontalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>